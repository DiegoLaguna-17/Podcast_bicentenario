from django.test import TestCase
from django.urls import reverse
from django.http import JsonResponse
from backend.models import Creadores  # Cambia esto si el modelo tiene otro nombre
from rest_framework.test import APIClient
from rest_framework import status

class PerfilCreadorTestCase(TestCase):
    def setUp(self):
        self.client = APIClient()
        self.creador = Creadores.objects.create(
            # Asegúrate de usar los campos requeridos para crear un creador válido
            nombre='Juan Pérez',
            biografia='Un creador de prueba.',
            correo='juan@example.com',
            # ... otros campos obligatorios
        )
        self.url = reverse('perfil_creador')  # o directamente '/api/perfil_creador/' si no tienes nombre de ruta

    def test_obtener_perfil_creador_exitoso(self):
        response = self.client.get(
            self.url,
            {'creadores_idcreador': self.creador.idcreador},  # o self.creador.pk si no tienes `idcreador`
            HTTP_AUTHORIZATION='Bearer testtoken'  # Simulación de token si lo requiere el decorador
        )
        self.assertEqual(response.status_code, status.HTTP_200_OK)
        self.assertIn('creador', response.json())
        self.assertEqual(response.json()['creador'][0]['idcreador'], self.creador.idcreador)

    def test_falta_parametro_creadores_idcreador(self):
        response = self.client.get(
            self.url,
            {},  # No se pasa el parámetro
            HTTP_AUTHORIZATION='Bearer testtoken'
        )
        self.assertEqual(response.status_code, status.HTTP_400_BAD_REQUEST)
        self.assertIn('error', response.json())

    def test_metodo_no_permitido(self):
        response = self.client.post(
            self.url,
            {'creadores_idcreador': self.creador.idcreador},
            HTTP_AUTHORIZATION='Bearer testtoken'
        )
        self.assertEqual(response.status_code, status.HTTP_405_METHOD_NOT_ALLOWED)
